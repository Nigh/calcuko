---
import { ClientRouter } from 'astro:transitions';
import ReloadPrompt from "../components/ReloadPrompt.svelte"
import "../styles/global.css"

interface Props {
	title: string
	description?: string
}

const { title, description = "支持多行变量公式与实时结果联动更新的 PWA 计算器。" } = Astro.props
const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`
---

<!doctype html>

<html lang="zh-CN" data-theme="xianii">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="manifest" href={`${base}manifest.webmanifest`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			const savedLocale = localStorage.getItem("calcuko-locale");
			const initialLocale = savedLocale === "zh-CN" || savedLocale === "en"
				? savedLocale
				: navigator.languages.some((language) => language.toLowerCase().startsWith("zh")) ? "zh-CN" : "en";
			document.documentElement.lang = initialLocale;
			if (initialLocale === "en") {
				document.title = "Calcuko - Multi-line Formula Calculator";
				document.querySelector('meta[name="description"]')?.setAttribute("content", "A web calculator with multi-line variables, live per-line results, and dependency updates.");
			}
		</script>
		<ClientRouter />
	</head>
	<body>
		<slot />
		<ReloadPrompt client:load />
	</body>
</html>
